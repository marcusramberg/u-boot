stdin=serial,button-kbd,usbacm
stdout=serial,vidconsole,usbacm
stderr=serial,vidconsole,usbacm

blkmapcmd=blkmap create root;
	  blkmap map root 0 ${blkmap_size_r} linear ${blkmap_blk_ifname} ${blkmap_blk_dev} ${blkmap_blk_nr}

preboot=run ufsblk; if test -z "${blkmap_size_r}"; then run ufsblk; fi; if test -z "${blkmap_size_r}"; then run ufsblk; fi; run blkmapcmd

bootdelay=5
bootcmd=bootefi bootmgr; pause; bootmenu

fastbootcmd=echo "Fastboot Mode";
	fastboot -l $fastboot_addr_r usb 0

bootmenu_0=Continue Boot=boot
bootmenu_1=Enter Fastboot Mode=run fastbootcmd
bootmenu_2=UEFI Maintenance Menu=eficonfig
bootmenu_3=Reboot=reset
bootmenu_4=Power Off=poweroff
bootmenu_5=Boot Appended Payload=bootappended

button_cmd_0_name=KEY_VOLUMEDOWN
button_cmd_0=bootmenu

pstorecmd=pstore set 0xbd0000000 0x400000 0x20000 0x200000 0x0 0x100000; pstore display console
bootmenu_6=Dump kernel ramoops=run pstorecmd; pause; bootmenu
ufsblk=ufs init; scsi scan; setenv blkmap_blk_ifname scsi; setenv blkmap_blk_dev 0; part start scsi 0 userdata ud_start; part size scsi 0 userdata blkmap_size_r; setexpr blkmap_blk_nr fmt %llu ${ud_start}
storagecmd=part list scsi 0; blkmap info; part list blkmap 0
bootmenu_7=Show storage (UFS GPT + nested userdata)=run storagecmd; pause; bootmenu
memmapcmd=bdinfo; efidebug memmap
bootmenu_8=Show DRAM banks + EFI memory map=run memmapcmd; pause; bootmenu
chgstat=i2c dev 0; echo MODE @bc want 05:; i2c md 0x69 0xbc 1; echo CNFG_12 @c8 CHG_EN=bit7 want e8:; i2c md 0x69 0xc8 1; echo CHG_DTLS @b8:; i2c md 0x69 0xb8 1; echo INT_OK @b6:; i2c md 0x69 0xb6 1; echo ILIM @c5:; i2c md 0x69 0xc5 1
bootmenu_9=Show charger state=run chgstat; pause; bootmenu
chgon=i2c dev 0; i2c mw 0x69 0xc8 0xe8; i2c mw 0x69 0xbc 0x05; run chgstat
bootmenu_10=Force charging on=run chgon; pause; bootmenu

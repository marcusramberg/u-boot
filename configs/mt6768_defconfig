CONFIG_ARM=y
CONFIG_COUNTER_FREQUENCY=13000000
CONFIG_POSITION_INDEPENDENT=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_TEXT_BASE=0x40080000
CONFIG_SYS_MALLOC_F_LEN=0x4000
CONFIG_NR_DRAM_BANKS=1
CONFIG_ENV_SIZE=0x1000
CONFIG_DEFAULT_DEVICE_TREE="mt6768-generic"
CONFIG_TARGET_MT6768=y
CONFIG_XIAOMI_LANCELOT=y
CONFIG_SYS_LOAD_ADDR=0x48000000
CONFIG_DEBUG_UART_BASE=0x11002000
CONFIG_DEBUG_UART_CLOCK=26000000
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_SERIAL_MEMLOG=y
CONFIG_DEBUG_UART_MEMLOG=y
CONFIG_BAUDRATE=921600
CONFIG_DM_SERIAL=y
# CONFIG_MTK_SERIAL is not set
CONFIG_DM_GPIO=y
CONFIG_CLK=y
CONFIG_CLK_CCF=y
CONFIG_DEVRES=y
CONFIG_OF_LIBFDT_OVERLAY=y
# Call ft_board_setup() before handing the dtb to Linux; that is where the real
# 3 GiB of RAM is declared (arch/arm/mach-mediatek/mt6768/init.c).
CONFIG_OF_BOARD_SETUP=y
# Preserve register x0 at U-Boot entry = the address of the real FDT LK hands
# on (0x4bc80000). Without this save_prev_bl_data.o is not linked in and
# get_prev_bl_fdt_addr() is only a macro returning 0.
CONFIG_SAVE_PREV_BL_FDT_ADDR=y
CONFIG_FIT=y
CONFIG_HUSH_PARSER=y
CONFIG_SYS_CBSIZE=256
CONFIG_SYS_PBSIZE=276
# CONFIG_PSCI_RESET is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_DISPLAY_BOARDINFO is not set
# CONFIG_ARCH_FIXUP_FDT_MEMORY is not set
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_CMD_GPT=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_BOOTI=y
CONFIG_MMC_MTK=y
CONFIG_PHY=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB=y
CONFIG_DM_USB_GADGET=y
CONFIG_USB_MUSB_HOST=n
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_MT6768=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VENDOR_NUM=0x0e8d
CONFIG_USB_GADGET_PRODUCT_NUM=0x201c
CONFIG_USB_ETHER=y
CONFIG_WDT=y
CONFIG_WDT_MTK=y
# CONFIG_POWER is not set
# CONFIG_INPUT is not set
# CONFIG_RANDOM_UUID is not set
CONFIG_LINUX_KERNEL_IMAGE_HEADER=y
CONFIG_LNX_KRNL_IMG_TEXT_OFFSET_BASE=0x40000000
CONFIG_DM_VIDEO=y
CONFIG_VIDEO=y
CONFIG_VIDEO_SIMPLE=y
CONFIG_VIDEO_FONT_8X16=y
CONFIG_CONSOLE_SCROLL_LINES=5
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_CONSOLE_MUX=y
CONFIG_BOARD_EARLY_INIT_F=y
CONFIG_BOARD_LATE_INIT=y
CONFIG_BOOTDELAY=2
CONFIG_BOOTCOMMAND="echo ==== copying dtb somewhere safe ====; cp.b 0x4a080000 0x60000000 0x10000; echo ==== BOOTI LINUX 6.18 ====; sleep 3; booti 0x47c80000 - 0x60000000; echo ==== BOOTI FAILED, RESET IN 30s ====; sleep 30; reset"
CONFIG_USE_BOOTCOMMAND=y
CONFIG_CMD_FASTBOOT=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x45000000
CONFIG_FASTBOOT_BUF_SIZE=0x08000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
